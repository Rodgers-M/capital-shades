{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm ci)",
			"Bash(npm run check)",
			"Bash(npm run lint)",
			"Bash(npm run format)",
			"Bash(npm run build)",
			"Bash(npx prettier --check:*)",
			"Bash(npx eslint:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch --show-current)",
			"Bash(git branch --list:*)"
		],
		"ask": [
			"Bash(npm install:*)",
			"Bash(npm uninstall:*)",
			"Bash(npm run deploy:*)",
			"Bash(npm run import-seed:*)",
			"Bash(npx sanity:*)",
			"Bash(git push:*)"
		],
		"deny": [
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git push --force-with-lease:*)",
			"Bash(rm -rf:*)",
			"Read(**/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.development)",
			"Read(**/.env.production)",
			"Read(**/.env.*.local)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edits.mjs\""
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint-edited.mjs\""
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"typescript-lsp@claude-plugins-official": true
	}
}
