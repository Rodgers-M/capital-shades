# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# --- Content (Sanity) — leave empty to use the built-in seed content ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed if the dataset is private
SANITY_READ_TOKEN=

# --- Enquiry emails (Resend, https://resend.com) — required in production ---
RESEND_API_KEY=
# Where enquiries are delivered
ENQUIRY_TO=info@capitalshades.co.ke
# Must be on a domain verified in Resend
ENQUIRY_FROM="Capital Shades Website <website@capitalshades.co.ke>"
